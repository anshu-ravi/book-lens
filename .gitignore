# Derived state: databases, digests, manifests. Contains derivative works of
# copyrighted books and must never be committed. Rebuild with `rm -rf data/ && reimport`.
data/

# The dev-corpus EPUBs themselves.
uploads/

# Secrets. Never committed, never read by tooling -- key names only.
.env
.env.*
!.env.example

