data/

# The dev-corpus EPUBs themselves.
uploads/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Secrets. Never committed, never read by tooling -- key names only.
.env
.env.*
!.env.example

# Frontend build artifacts and dependencies.
web/frontend/node_modules/
web/frontend/build/
web/frontend/.svelte-kit/
