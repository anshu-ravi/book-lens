# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration
GOOGLE_API_KEY=your-google-api-key-here

# Neo4j Knowledge Graph Configuration
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=password

# LLM Model Configuration (all optional, defaults to gemini-3.1-flash-lite)
# MODEL_EXTRACTION=gemini-3.1-flash-lite          # BRONZE stage: knowledge extraction
# MODEL_QA_GENERATION=gemini-3.1-flash-lite       # Q&A: answer questions
# MODEL_SERIES_LOOKUP=gemini-3.1-flash-lite       # Series metadata detection
# MODEL_DEFAULT=gemini-3.1-flash-lite             # Fallback for other tasks

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here   # Backend only — bypasses RLS
SUPABASE_ANON_KEY=your_supabase_anon_key_here      # Passed to frontend via /config

# Application Configuration
LIBRARY_PATH=./library.json
UPLOAD_DIR=./uploads

# Optional: Model Configuration
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# LLM_MODEL=claude-haiku-4-5-20251001

# Optional: Admin Features
ADMIN_USER_ID=  # Set to your Supabase user UUID to enable admin book edits
