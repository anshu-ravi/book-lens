# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_service_role_key_here   # Backend only — bypasses RLS
SUPABASE_ANON_KEY=your_supabase_anon_key_here      # Passed to frontend via /config

# Optional: Qdrant Vector Database Configuration (Legacy)
# QDRANT_URL=your_qdrant_cloud_url_here
# QDRANT_API_KEY=your_qdrant_api_key_here

# Application Configuration
LIBRARY_PATH=./library.json
UPLOAD_DIR=./uploads

# Optional: Model Configuration
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# LLM_MODEL=claude-haiku-4-5-20251001

# Optional: Admin Features
ADMIN_USER_ID=  # Set to your Supabase user UUID to enable admin book edits
