{
    "version": 2,
    "builds": [
        {
            "src": "src/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(static/.*)",
            "dest": "src/$1"
        },
        {
            "src": "/(.*)",
            "dest": "src/main.py"
        }
    ]
}